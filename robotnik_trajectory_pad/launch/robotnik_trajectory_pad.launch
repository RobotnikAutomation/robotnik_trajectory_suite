<?xml version="1.0"?>
<launch>

  <arg name="launch_ps4_joystick" default="true"/>
  <arg name="ps4_joy_dev" default="/dev/input/js_base"/>
  <arg name="ps4_autorepeat_rate" default="20.0"/>
  <arg name="ps4_deadzone" default="0.05"/>
  <arg name="launch_itowa_joystick" default="true"/>
  <arg name="itowa_port" default="/dev/ttyUSB_ITOWA"/>
  <arg name="itowa_serial_reconnect_interval" default="1.0"/>
  <arg name="itowa_serial_read_timeout" default="0.05"/>
  <arg name="itowa_frame_timeout" default="0.2"/>

 <!-- PS4 joy node -->
  <group if="$(arg launch_ps4_joystick)">
    <node name="ps4_joystick" pkg="joy" type="joy_node" respawn="true" respawn_delay="2.0">
      <param name="dev" type="string" value="$(arg ps4_joy_dev)" />
      <param name="autorepeat_rate" type="double" value="$(arg ps4_autorepeat_rate)" />
      <param name="deadzone" type="double" value="$(arg ps4_deadzone)" />
      <remap from="joy" to="ps4_joy"/>
    </node>
  </group>
  
  <!-- ITOWA joy node -->
  <group if="$(arg launch_itowa_joystick)">
    <node type="itowa_safe_pad.py" name="itowa_safe_joystick" pkg="itowa_safe_pad" output="screen" respawn="true" respawn_delay="2.0">
      <param name="port" value="$(arg itowa_port)" type="string"/>
      <param name="serial_reconnect_interval" value="$(arg itowa_serial_reconnect_interval)" type="double"/>
      <param name="serial_read_timeout" value="$(arg itowa_serial_read_timeout)" type="double"/>
      <param name="frame_timeout" value="$(arg itowa_frame_timeout)" type="double"/>
      <param name="joy_topic_name" value="itowa_joy" type="string"/>
    </node>
  </group>
  
  <node name="robotnik_trajectory_pad_node" pkg="robotnik_trajectory_pad" type="robotnik_trajectory_pad_node" output="screen" respawn="true">
  	<rosparam command="load" file="$(find robotnik_trajectory_pad)/config/robotnik_trajectory_pad.yaml" /> 
  </node>
  
</launch>
